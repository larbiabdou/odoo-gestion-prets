<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_loan_bank_account_view_list" model="ir.ui.view">
        <field name="name">hr.loan.bank.account.list</field>
        <field name="model">hr.loan.bank.account</field>
        <field name="arch" type="xml">
            <list decoration-danger="balance &lt; 0">
                <field name="name"/>
                <field name="bank_name"/>
                <field name="acc_number"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="initial_balance" sum="Total"/>
                <field name="amount_disbursed" sum="Total" optional="show"/>
                <field name="amount_repaid" sum="Total" optional="show"/>
                <field name="balance" sum="Total"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="hr_loan_bank_account_view_form" model="ir.ui.view">
        <field name="name">hr.loan.bank.account.form</field>
        <field name="model">hr.loan.bank.account</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_open_loans" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="loan_count" widget="statinfo" string="Prêts"/>
                        </button>
                        <button name="action_open_installments" type="object" class="oe_stat_button" icon="fa-list" string="Échéances payées"/>
                    </div>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="ex. Compte BNA principal"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="bank_name"/>
                            <field name="acc_number"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="initial_balance"/>
                            <field name="amount_disbursed"/>
                            <field name="amount_repaid"/>
                            <field name="balance" class="fw-bold" decoration-danger="balance &lt; 0"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_loan_bank_account_view_search" model="ir.ui.view">
        <field name="name">hr.loan.bank.account.search</field>
        <field name="model">hr.loan.bank.account</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="bank_name"/>
                <field name="acc_number"/>
                <filter name="archived" string="Archivés" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_hr_loan_bank_account" model="ir.actions.act_window">
        <field name="name">Comptes bancaires</field>
        <field name="res_model">hr.loan.bank.account</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_loan_bank_account_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créer un compte bancaire</p>
            <p>Chaque prêt est décaissé depuis un compte ; le solde évolue avec les prêts validés et les échéances payées.</p>
        </field>
    </record>


</odoo>
