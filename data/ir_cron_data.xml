<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Vérification quotidienne : seules les tranches échues (le 30 du mois) sont payées -->
    <record id="ir_cron_pay_due_installments" model="ir.cron">
        <field name="name">Prêts : paiement automatique des tranches échues</field>
        <field name="model_id" ref="model_hr_employee_loan_line"/>
        <field name="state">code</field>
        <field name="code">model._cron_pay_due_installments()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 00:30:00')"/>
    </record>
</odoo>
